{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about-us", "destination": "/om-oss", "permanent": true },
    { "source": "/contact", "destination": "/kontakt", "permanent": true },
    { "source": "/faqs", "destination": "/vanliga-fragor", "permanent": true }
  ],
  "rewrites": [
    { "source": "/arende/:token([0-9a-fA-F]{32})/fil/:id([0-9a-fA-F-]{8,64})", "destination": "/api/arende/fil?token=:token&id=:id" },
    { "source": "/arende/:token([0-9a-fA-F]{32})", "destination": "/arende-status" }
  ],
  "headers": [
    {
      "source": "/arende/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/arende-status",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
